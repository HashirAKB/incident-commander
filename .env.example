# Copy to .env and fill in what you need. Never commit .env.

# Live model (optional). Without a key everything runs on the deterministic fake model (mode=mock).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force the fake model even when a key is set (tests and evals do this).
IC_MODE=mock

# Checkpoints and write ledger. Empty = SQLite files in IC_DATA_DIR.
DATABASE_URL=
IC_DATA_DIR=data
IC_RUNS_DIR=runs
IC_TRACES_DIR=traces

# Approvals. The HTTP API is read-only without APPROVER_TOKEN and refuses non-local binds.
APPROVER_TOKEN=
APPROVAL_TTL=4h

# Budgets per run (defaults shown).
IC_MAX_STEPS=40
IC_MAX_TOKENS=60000
IC_MAX_COST_USD=0.50

# Telemetry MCP server: auto (real if vendored, else stub) | stub | real.
IC_TELEMETRY=auto
# Or a telemetry server running as a service (docker compose), over streamable HTTP:
IC_TELEMETRY_URL=
TELEMETRY_MCP_TOKEN=

# LangSmith tracing stays off unless both are set. OpenTelemetry JSONL in traces/ is always on.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
